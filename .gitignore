.DS_Store
*.o
*.dsym
# macOS emits .dSYM, which *.dsym does not match: git globs are case sensitive.
*.dSYM/

# Local environment / secrets. Covers .env, .env.dev, .env.prod, .env.test ...
/.envrc
/.env*

# Editor state, wherever it appears in the tree.
.vscode/
.idea/

# Generated by set_git_version_and_generate_header().
**/ebisu_version.h

# CMake build trees. The test Makefiles configure in-source into build-<lib>/.
/build/
build-khc/
build-kii/
build-jkii/
build-tio/
CMakeCache.txt
CMakeFiles/

# Test binaries and results.
tests/small_test/khc/testapp
tests/small_test/kii/small-test
tests/small_test/jkii/testapp
tests/small_test/tio/small-test
tests/large_test/khc/large-test
tests/large_test/kii/testapp
test-results/

# Doxygen output.
html/
/ebisu-doc/
