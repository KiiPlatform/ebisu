# For QEMU, on top of sdkconfig.defaults:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.qemu" build
# QEMU has no Wi-Fi. It emulates an OpenCores Ethernet MAC instead, which
# ESP-IDF has a driver for, and its user-mode networking reaches the internet.
CONFIG_EXAMPLE_CONNECT_WIFI=n
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_EXAMPLE_USE_OPENETH=y
CONFIG_ETH_USE_OPENETH=y
